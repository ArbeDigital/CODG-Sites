---
const servicesLeft = [
  "Dental Exams",
  "Dental Cleaning",
  "Family Dentistry",
  "Cosmetic Dentistry",
  "Dentistry for Kids",
  "Bridges",
  "Crowns",
  "Dental Implants",
  "Dentures",
];

const servicesRight = [
  "Emergency Dentistry",
  "Endodontics",
  "Sports Mouth Guards",
  "Oral Surgery",
  "Partials",
  "Root Canals",
  "Teeth Whitening",
  "Veneers",
];
---

<section class="mx-auto max-w-[1425px] px-6 md:px-12 xl:px-[90px]">
  <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <h2>Our Services</h2>
      <div class="medium-p mt-4">
        <p>
          Whether you&rsquo;re visiting for a routine check-up or its your
          first dental healthcare visit in years, we&rsquo;ve got you covered.
        </p>
      </div>

      <div class="medium-p mt-6 grid grid-cols-1 gap-x-10 sm:grid-cols-2">
        <ul class="services-list">
          {servicesLeft.map((service) => <li>{service}</li>)}
        </ul>
        <ul class="services-list">
          {servicesRight.map((service) => <li>{service}</li>)}
        </ul>
      </div>
    </div>

    <div class="p-[4%] max-lg:mx-auto max-lg:max-w-[400px]">
      <img
        src="/images/happy-couple.jpg"
        alt="A happy couple smiling outdoors"
        class="w-full rounded-[240px]"
        width="500"
        height="750"
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  .services-list li {
    position: relative;
    padding-left: 22px;
  }

  .services-list li::before {
    content: "";
    position: absolute;
    top: 13px;
    left: 6px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: currentColor;
  }
</style>
