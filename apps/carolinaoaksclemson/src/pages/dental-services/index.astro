---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import services from "../../data/services.json";
import { publicImage } from "../../lib/images";
---

<BaseLayout
  title="Dental Services | Carolina Oaks Dental Care Clemson"
  description="Explore general, restorative, and cosmetic dental services at Carolina Oaks Dental Care of Clemson."
  transparentHeader
>
  <PageHero
    title="Dental Services"
    intro="From preventive care to restorative and cosmetic treatments, our Clemson team helps you achieve a healthier, more confident smile."
    image="/images/banner-dental-general.jpg"
    cta={{ label: "Request An Appointment", href: "/contact-us/" }}
  />

  <section class="mx-auto max-w-[1425px] px-6 py-14 md:px-12 xl:px-[90px]">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <a
            href={`/dental-services/${service.slug}/`}
            class="group overflow-hidden rounded-xl bg-white shadow-[0_8px_30px_rgba(47,58,53,0.08)] transition-transform hover:-translate-y-1"
          >
            <img
              src={publicImage(service.heroImage)}
              alt=""
              class="aspect-[16/10] w-full object-cover"
              width="640"
              height="400"
              loading="lazy"
            />
            <div class="p-6">
              <h2 class="text-[26px]! leading-8! transition-colors group-hover:text-accent">{service.title}</h2>
              <p class="mt-3 line-clamp-3 text-[15px] leading-6">{service.intro}</p>
              <span class="mt-4 inline-block text-[13px] font-bold tracking-[2px] text-accent uppercase">Learn More</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
