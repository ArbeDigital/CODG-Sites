---
import { publicImage } from "../lib/images";

interface Props {
  heading: string;
  image: string;
  imageAlt?: string;
  /** Which side the image appears on (desktop). Defaults to right. */
  imagePosition?: "left" | "right";
}

const { heading, image, imageAlt = "", imagePosition = "right" } = Astro.props;
const src = publicImage(image) || image;
---

<section class="media-split py-10 md:py-14">
  <div class="mx-auto grid max-w-[1425px] items-center gap-8 px-6 md:gap-12 md:px-12 lg:grid-cols-2 xl:gap-16 xl:px-[90px]">
    <div class:list={["service-prose", imagePosition === "left" ? "lg:order-2" : "lg:order-1"]}>
      <h2 class="mt-0!">{heading}</h2>
      <slot />
    </div>

    <div
      class:list={[
        "max-lg:mx-auto max-lg:w-full max-lg:max-w-[420px]",
        imagePosition === "left" ? "lg:order-1" : "lg:order-2",
      ]}
    >
      <img
        src={src}
        alt={imageAlt || heading}
        class="aspect-[2/3] w-full rounded-[12px] object-cover"
        width="500"
        height="750"
        loading="lazy"
      />
    </div>
  </div>
</section>
