---
import site from "../data/site.json";
---

<section class="bg-brand text-white">
  <div class="mx-auto grid max-w-[1425px] grid-cols-1 items-center gap-10 px-6 py-14 md:px-12 lg:grid-cols-2 xl:px-[90px]">
    <div>
      <img
        src="/images/clemson-map-1.jpg"
        alt="Map of Carolina Oaks Dental Care of Clemson"
        class="w-full rounded-lg shadow-lg"
        width="1024"
        height="347"
        loading="lazy"
      />
    </div>
    <div>
      <h2 class="text-white!">Visit Our Clemson Office</h2>
      <p class="mt-4 text-[18px] leading-8 text-white/90">
        Ready to schedule? Request an appointment or give us a call — our team is happy to help.
      </p>
      <a href="/contact-us/" class="btn btn-jumbo mt-6 bg-accent">Request An Appointment</a>
      <div class="mt-8 grid gap-6 sm:grid-cols-3">
        <div>
          <h6 class="text-gold!">Phone</h6>
          <a href={`tel:${site.phoneTel}`} class="mt-2 block text-white hover:opacity-80">{site.phone}</a>
        </div>
        <div>
          <h6 class="text-gold!">Address</h6>
          <p class="mt-2 text-white/90">
            {site.address.lines[0]}<br />
            {site.address.lines[1]}
          </p>
        </div>
        <div>
          <h6 class="text-gold!">Hours</h6>
          <ul class="mt-2 space-y-1 text-white/90">
            {
              site.hours.map((h) => (
                <li>
                  <strong>{h.days}:</strong> {h.hours}
                  {h.note ? <span class="block text-[13px] text-white/70">{h.note}</span> : null}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
