---
import home from "../data/home.json";
import { publicImage } from "../lib/images";

const hero = home.hero;
const img = publicImage(hero.image);
---

<section
  id="hero"
  class="relative flex items-center overflow-hidden bg-[#853919] text-white md:min-h-[100svh]"
>
  {/* Desktop/tablet only — mobile uses solid brand color so the subject isn’t cropped */}
  <div
    class="absolute inset-0 hidden bg-cover bg-center md:block"
    style={`background-image: url(${img})`}
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto w-full max-w-[1425px] px-6 pt-36 pb-24 md:px-12 md:pt-48 md:pb-40 xl:px-[90px]">
    <h1 class="max-w-3xl text-white!">{hero.headline}</h1>
    <p class="mt-6 max-w-xl text-[18px] leading-8 text-white/95">{hero.subcopy}</p>
    <a
      href={hero.cta.href}
      class="btn btn-jumbo mt-8 mb-6 bg-[#f1c40f] hover:bg-[#f1c40f] md:mb-14"
    >
      {hero.cta.label}
    </a>
  </div>
  <img
    src="/images/acorn-divider-grey.svg"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute right-0 bottom-0 left-0 w-full"
  />
</section>
