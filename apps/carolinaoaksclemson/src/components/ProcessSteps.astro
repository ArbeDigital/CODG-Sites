---
interface Step {
  title: string;
  bodyHtml: string;
}

interface Props {
  heading: string;
  introHtml?: string;
  processHeading?: string;
  steps: Step[];
}

const { heading, introHtml, processHeading, steps } = Astro.props;
---

<section class="py-10 md:py-14">
  <div class="mx-auto max-w-[900px] px-6 md:px-12">
    <div class="service-prose">
      <h2 class="mt-0!">{heading}</h2>
      {introHtml ? <div class="medium-p" set:html={introHtml} /> : null}
      {
        processHeading ? (
          <h3 class="mt-10! md:mt-12!">{processHeading}</h3>
        ) : null
      }
    </div>

    <ol class="process-steps mt-8 space-y-0">
      {
        steps.map((step, i) => (
          <li class="process-step relative flex gap-5 pb-10 last:pb-0 md:gap-6 md:pb-12">
            <div class="flex flex-col items-center">
              <span
                class="font-heading flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#f4f4f4] text-[22px] font-semibold text-black/50 md:h-14 md:w-14 md:text-[26px]"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              {i < steps.length - 1 ? (
                <span class="mt-3 w-px flex-1 bg-[#d8d5d2]" aria-hidden="true" />
              ) : null}
            </div>
            <div class="service-prose medium-p min-w-0 pt-2">
              <h4 class="mt-0! text-[22px]! leading-8! text-[#291f1c]! md:text-[26px]! md:leading-9!">
                {step.title}
              </h4>
              <div class="mt-2" set:html={step.bodyHtml} />
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
