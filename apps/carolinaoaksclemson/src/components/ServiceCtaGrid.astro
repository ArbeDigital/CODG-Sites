---
import home from "../data/home.json";
import { publicImage } from "../lib/images";

const ctas = home.serviceCtas;
---

<section class="py-[6%]">
  <div class="mx-auto max-w-[1425px] px-6 md:px-12 xl:px-[90px]">
    <h2 class="text-center">Dental Care Designed Around You</h2>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        ctas.map((cta) => (
          <a
            href={cta.href}
            class="group relative block min-h-[280px] overflow-hidden rounded-xl bg-brand bg-cover bg-center text-white"
            style={`background-image: linear-gradient(rgba(82,47,32,0.55), rgba(82,47,32,0.75)), url(${publicImage(cta.image)})`}
          >
            <div class="absolute inset-x-0 bottom-0 p-6 transition-transform duration-300 group-hover:-translate-y-1">
              <h3 class="text-[24px]! leading-8! text-white!">{cta.title}</h3>
              <p class="mt-2 text-[15px] leading-6 text-white/90">{cta.blurb}</p>
            </div>
          </a>
        ))
      }
    </div>
    <div class="mt-10 text-center">
      <a href="/dental-services/" class="btn btn-large">View All Services</a>
    </div>
  </div>
</section>
