---
interface Card {
  title: string;
  bodyHtml: string;
}

interface Props {
  heading: string;
  introHtml: string;
  cards: Card[];
  footerHtml?: string;
}

const { heading, introHtml, cards, footerHtml } = Astro.props;
---

<section class="bg-[#f4f4f4] py-10 md:py-14">
  <div class="mx-auto max-w-[1425px] px-6 md:px-12 xl:px-[90px]">
    <div class="service-prose max-w-[900px]">
      <h2 class="mt-0!">{heading}</h2>
      <div class="medium-p" set:html={introHtml} />
    </div>

    <div
      class:list={[
        "mt-8 grid gap-6 md:mt-10 md:gap-8 lg:gap-10",
        cards.length === 3 ? "md:grid-cols-3" : "md:grid-cols-2 lg:gap-12",
      ]}
    >
      {
        cards.map((card) => (
          <article class="rounded-[10px] bg-white p-8 md:p-[50px]">
            <h5 class="mt-0! text-[22px]! leading-8! text-[#291f1c]! md:text-[26px]! md:leading-9!">
              {card.title}
            </h5>
            <div class="medium-p mt-3" set:html={card.bodyHtml} />
          </article>
        ))
      }
    </div>

    {
      footerHtml ? (
        <div class="service-prose medium-p mt-8 max-w-[900px] md:mt-10" set:html={footerHtml} />
      ) : null
    }
  </div>
</section>
