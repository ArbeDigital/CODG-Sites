---
interface Props {
  title: string;
  description: string;
  href: string;
  image: string;
  imageAlt?: string;
  pubDate?: Date;
}

const { title, description, href, image, imageAlt, pubDate } = Astro.props;
---

<a href={href} class="group block overflow-hidden rounded-xl bg-white shadow-[0_8px_30px_rgba(47,58,53,0.08)] transition-transform hover:-translate-y-1">
  <img
    src={image}
    alt={imageAlt || title}
    class="aspect-[16/10] w-full object-cover"
    width="800"
    height="500"
    loading="lazy"
  />
  <div class="p-6">
    {
      pubDate && (
        <time class="text-[12px] tracking-[1.5px] text-body uppercase" datetime={pubDate.toISOString()}>
          {pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
        </time>
      )
    }
    <h3 class="mt-2 text-[24px]! leading-8! transition-colors group-hover:text-accent">{title}</h3>
    <p class="mt-3 line-clamp-3 text-[15px] leading-6">{description}</p>
    <span class="mt-4 inline-block text-[13px] font-bold tracking-[2px] text-accent uppercase">Read More</span>
  </div>
</a>
