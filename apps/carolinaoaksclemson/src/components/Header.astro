---
import services from "../data/services.json";
import site from "../data/site.json";

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;

const primary = [
  { label: "Home", href: "/" },
  { label: "Services", href: "/dental-services/", children: services.map((s) => ({ label: s.title, href: `/dental-services/${s.slug}/` })) },
  { label: "Blog", href: "/blog/" },
  { label: "Forms", href: "/dental-forms/" },
  { label: "Contact", href: "/contact-us/" },
];

const locations = site.sisterLocations;
---

<header
  id="site-header"
  data-transparent={transparent ? "true" : "false"}
  class:list={[
    "top-0 right-0 left-0 z-40 transition-[background-color,box-shadow,padding] duration-300",
    transparent ? "fixed" : "sticky bg-white shadow-[0_1px_10px_rgba(0,0,0,0.12)]",
  ]}
>
  <div class="mx-auto flex max-w-[1425px] items-center justify-between px-5 py-3 lg:justify-center lg:px-8 lg:py-5">
    <a href="/" class="lg:hidden" aria-label="Carolina Oaks Dental Care Clemson — Home">
      <img
        src="/images/CO_Clemson.png"
        alt="Carolina Oaks Dental Care of Clemson"
        class="logo-dark h-[52px] w-auto"
        width="180"
        height="52"
      />
      <img
        src="/images/CO_Clemson-logo.png"
        alt=""
        aria-hidden="true"
        class="logo-light hidden h-[52px] w-auto"
        width="180"
        height="52"
      />
    </a>

    <nav
      class="hidden w-full max-w-[1200px] grid-cols-[1fr_auto_1fr] items-center gap-x-4 xl:gap-x-6 lg:grid"
      aria-label="Primary"
    >
      <div class="flex items-center justify-end gap-1 xl:gap-3">
        {
          primary.slice(0, 3).map((item) =>
            item.children ? (
              <div class="group relative">
                <a
                  href={item.href}
                  class="nav-link font-heading inline-flex items-center gap-1 px-2 py-2 text-[13px] leading-[18px] font-bold tracking-[1.5px] uppercase transition-opacity hover:opacity-70"
                >
                  {item.label}
                  <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true" class="opacity-70"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
                </a>
                <ul class="invisible absolute top-full left-0 z-50 min-w-[260px] translate-y-1 bg-white py-3 opacity-0 shadow-[0_12px_40px_rgba(0,0,0,0.14)] transition group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} class="block px-5 py-2 text-[14px] text-ink transition-colors hover:bg-[#f5efe9] hover:text-brand">
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
              <a
                href={item.href}
                class="nav-link font-heading px-2 py-2 text-[13px] leading-[18px] font-bold tracking-[1.5px] uppercase transition-opacity hover:opacity-70"
              >
                {item.label}
              </a>
            )
          )
        }
      </div>

      <a href="/" class="shrink-0" aria-label="Carolina Oaks Dental Care Clemson — Home">
        <img
          src="/images/CO_Clemson.png"
          alt="Carolina Oaks Dental Care of Clemson"
          class="logo-dark h-[72px] w-auto"
          width="220"
          height="72"
        />
        <img
          src="/images/CO_Clemson-logo.png"
          alt=""
          aria-hidden="true"
          class="logo-light hidden h-[72px] w-auto"
          width="220"
          height="72"
        />
      </a>

      <div class="flex items-center justify-start gap-1 xl:gap-3">
        {
          primary.slice(3).map((item) => (
            <a
              href={item.href}
              class="nav-link font-heading px-2 py-2 text-[13px] leading-[18px] font-bold tracking-[1.5px] uppercase transition-opacity hover:opacity-70"
            >
              {item.label}
            </a>
          ))
        }

        <div class="group relative">
          <button
            type="button"
            class="nav-link font-heading inline-flex items-center gap-1 px-2 py-2 text-[13px] leading-[18px] font-bold tracking-[1.5px] uppercase transition-opacity hover:opacity-70"
          >
            Other Locations
            <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true" class="opacity-70"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
          </button>
          <ul class="invisible absolute top-full right-0 z-50 min-w-[200px] translate-y-1 bg-white py-3 opacity-0 shadow-[0_12px_40px_rgba(0,0,0,0.14)] transition group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
            {
              locations.map((loc) => (
                <li>
                  <a
                    href={loc.url}
                    target="_blank"
                    rel="noopener"
                    class="block px-5 py-2 text-[14px] text-ink transition-colors hover:bg-[#f5efe9] hover:text-brand"
                  >
                    {loc.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </nav>

    <button
      id="menu-open"
      type="button"
      class="nav-link flex items-center gap-3 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="font-heading text-[15px] font-bold tracking-[2px] uppercase">Menu</span>
      <span class="flex flex-col gap-[5px]" aria-hidden="true">
        <span class="menu-line block h-[2px] w-[22px]"></span>
        <span class="menu-line block h-[2px] w-[22px]"></span>
        <span class="menu-line block h-[2px] w-[22px]"></span>
      </span>
    </button>
  </div>
</header>

<div
  id="mobile-menu"
  class="bg-brand invisible fixed inset-0 z-50 flex items-center justify-center overflow-y-auto opacity-0 transition-[opacity,visibility] duration-300"
  hidden
>
  <button
    id="menu-close"
    type="button"
    class="absolute top-6 right-6 p-3 text-white transition-opacity hover:opacity-70"
    aria-label="Close menu"
  >
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M18 6 6 18M6 6l12 12"></path>
    </svg>
  </button>

  <nav aria-label="Mobile" class="w-full max-w-lg px-8 py-20">
    <ul class="flex flex-col items-center gap-5 text-center">
      {
        primary.map((item) => (
          <li>
            <a href={item.href} class="font-heading text-[28px] leading-[34px] font-bold text-white capitalize transition-opacity hover:opacity-70">
              {item.label}
            </a>
            {item.children && (
              <ul class="mt-3 flex flex-col gap-2">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} class="text-[15px] text-white/85 transition-opacity hover:opacity-70">
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
      <li class="pt-4">
        <p class="mb-3 text-[12px] tracking-[2px] text-white/60 uppercase">Other Locations</p>
        <ul class="flex flex-col gap-2">
          {
            locations.map((loc) => (
              <li>
                <a href={loc.url} target="_blank" rel="noopener" class="text-[18px] text-white transition-opacity hover:opacity-70">
                  {loc.name}
                </a>
              </li>
            ))
          }
        </ul>
      </li>
    </ul>
  </nav>
</div>

<style>
  #site-header .nav-link {
    color: var(--color-ink);
  }
  #site-header .menu-line {
    background-color: var(--color-ink);
  }

  #site-header.is-transparent {
    background-color: transparent;
    box-shadow: none;
  }
  #site-header.is-transparent .nav-link {
    color: #fff;
  }
  #site-header.is-transparent .menu-line {
    background-color: #fff;
  }
  #site-header.is-transparent .logo-dark {
    display: none;
  }
  #site-header.is-transparent .logo-light {
    display: block;
  }

  #site-header[data-transparent="true"]:not(.is-transparent) {
    background-color: #fff;
    box-shadow: 0 1px 10px rgba(0, 0, 0, 0.12);
  }

  #mobile-menu.is-open {
    visibility: visible;
    opacity: 1;
  }
</style>

<script>
  const header = document.getElementById("site-header")!;
  const menu = document.getElementById("mobile-menu")!;
  const openBtn = document.getElementById("menu-open")!;
  const closeBtn = document.getElementById("menu-close")!;

  if (header.dataset.transparent === "true") {
    const update = () => {
      header.classList.toggle("is-transparent", window.scrollY < 60);
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
  }

  menu.removeAttribute("hidden");

  const setOpen = (open: boolean) => {
    menu.classList.toggle("is-open", open);
    openBtn.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";
  };

  openBtn.addEventListener("click", () => setOpen(true));
  closeBtn.addEventListener("click", () => setOpen(false));
  menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
</script>
