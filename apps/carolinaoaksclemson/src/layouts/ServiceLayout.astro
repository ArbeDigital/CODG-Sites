---
import BaseLayout from "./BaseLayout.astro";
import { publicImage } from "../lib/images";

interface Props {
  title: string;
  description: string;
  intro?: string;
  heroImage?: string;
}

const { title, description, intro, heroImage } = Astro.props;
const heroSrc = publicImage(heroImage) || "/images/banner-dental-general.jpg";
---

<BaseLayout title={`${title} | Carolina Oaks Dental Care Clemson`} description={description} ogImage={heroSrc}>
  <section
    class="relative flex min-h-[420px] items-end bg-brand bg-cover bg-center text-white"
    style={`background-image: linear-gradient(90deg, rgba(82,47,32,0.88) 0%, rgba(82,47,32,0.35) 70%), url(${heroSrc})`}
  >
    <div class="mx-auto w-full max-w-[1425px] px-6 py-16 md:px-12 xl:px-[90px]">
      <h1 class="max-w-2xl text-white!">{title}</h1>
      {intro && <p class="medium-p mt-4 max-w-xl text-[18px] leading-8 text-white/90">{intro}</p>}
      <a href="/contact-us/" class="btn btn-jumbo mt-8">Request An Appointment</a>
    </div>
  </section>

  <div class="mx-auto max-w-[900px] px-6 py-14 md:px-12 service-prose">
    <slot />
  </div>
</BaseLayout>

<style is:global>
  .service-prose h2 {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .service-prose h3,
  .service-prose h4 {
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }
  .service-prose p + p {
    margin-top: 1rem;
  }
  .service-prose ul {
    margin: 1rem 0 1rem 1.25rem;
    list-style: disc;
  }
  .service-prose ol {
    margin: 1rem 0 1rem 1.25rem;
    list-style: decimal;
  }
  .service-prose li + li {
    margin-top: 0.35rem;
  }
  .service-prose img {
    margin: 1.5rem 0;
    border-radius: 12px;
    width: 100%;
    height: auto;
  }
</style>
