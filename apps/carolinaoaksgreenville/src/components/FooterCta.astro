---
import site from "../data/site.json";
---

<section class="bg-[#274c4f] text-white">
  <div class="mx-auto grid max-w-[1425px] grid-cols-1 items-stretch gap-10 px-6 py-14 md:px-12 lg:grid-cols-2 xl:px-[90px]">
    <div class="min-h-[320px] overflow-hidden rounded-lg shadow-lg lg:min-h-full">
      <iframe
        title="Carolina Oaks Dental Care of Greenville map"
        src={site.mapEmbedUrl}
        width="600"
        height="450"
        class="h-full min-h-[320px] w-full border-0 lg:min-h-[420px]"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>
    <div>
      <h2 class="text-white!">Complete dental care for you and your family</h2>
      <p class="mt-4 text-[18px] leading-8 text-white/90">
        Carolina Oaks always puts your oral health and comfort first. Whether you haven’t had a dental appointment in a while, you’re experiencing pain or it’s time for your check-up, call our friendly team to schedule your next appointment. Our down-to-earth, approachable dentists will help you achieve a beautiful, bright, healthy smile.
      </p>
      <a href="/contact-us/" class="btn btn-jumbo mt-6 bg-[#f1c40f] hover:bg-[#f1c40f]">Request An Appointment</a>
      <div class="mt-8 grid gap-8 sm:grid-cols-2">
        <div class="space-y-6">
          <div>
            <h6 class="text-gold!">Phone</h6>
            <a href={`tel:${site.phoneTel}`} class="mt-2 block text-white hover:opacity-80">{site.phone}</a>
          </div>
          <div>
            <h6 class="text-gold!">Address</h6>
            <p class="mt-2 text-white/90">
              {site.address.lines[0]}<br />
              {site.address.lines[1]}
            </p>
          </div>
        </div>
        <div>
          <h6 class="text-gold!">Hours</h6>
          <ul class="mt-2 space-y-1 text-white/90">
            {
              site.hours.map((h) => (
                <li>
                  <strong>{h.days}:</strong> {h.hours}
                  {h.note ? <span class="block text-[13px] text-white/70">{h.note}</span> : null}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
