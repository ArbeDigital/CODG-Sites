---
interface Card {
  title?: string;
  bodyHtml: string;
}

interface Props {
  heading: string;
  introHtml?: string;
  cards: Card[];
  footerHtml?: string;
  columns?: 1 | 2 | 3;
}

const { heading, introHtml = "", cards, footerHtml, columns } = Astro.props;

const colClass =
  columns === 1
    ? "grid-cols-1"
    : columns === 2
      ? "md:grid-cols-2"
      : columns === 3
        ? "md:grid-cols-3"
        : cards.length === 3 || cards.length === 6
          ? "md:grid-cols-3"
          : "md:grid-cols-2";
---

<section class="bg-[#f4f4f4] py-10 md:py-14">
  <div class="mx-auto max-w-[1425px] px-6 md:px-12 xl:px-[90px]">
    <div class="service-prose max-w-[900px]">
      <h2 class="mt-0!">{heading}</h2>
      {introHtml ? <div class="medium-p" set:html={introHtml} /> : null}
    </div>

    <div class:list={["mt-8 grid gap-6 md:mt-10 md:gap-8 lg:gap-10", colClass]}>
      {
        cards.map((card) => (
          <article class="rounded-[10px] bg-white p-8 md:p-[50px]">
            {card.title ? (
              <h5 class="mt-0! text-[22px]! leading-8! text-[#291f1c]! md:text-[26px]! md:leading-9!">
                {card.title}
              </h5>
            ) : null}
            <div class:list={["medium-p", card.title ? "mt-3" : null]} set:html={card.bodyHtml} />
          </article>
        ))
      }
    </div>

    {
      footerHtml ? (
        <div class="service-prose medium-p mt-8 max-w-[900px] md:mt-10" set:html={footerHtml} />
      ) : null
    }
  </div>
</section>
