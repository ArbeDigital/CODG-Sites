---
import home from "../data/home.json";
import { publicImage } from "../lib/images";

const doctors = home.doctors;
---

<section class="bg-white py-[6%]">
  <div class="mx-auto max-w-[1425px] px-6 md:px-12 xl:px-[90px]">
    <h2 class="text-center">Meet Our Dentists</h2>
    <div class="mt-12 grid gap-12 lg:grid-cols-2">
      {
        doctors.map((doc) => (
          <article class="flex flex-col items-center text-center sm:flex-row sm:items-start sm:text-left gap-6">
            <img
              src={publicImage(doc.image)}
              alt={`Portrait of ${doc.title}, dentist at Carolina Oaks Dental Care of Greenville`}
              class="h-[180px] w-[180px] shrink-0 rounded-full object-cover"
              width="180"
              height="180"
              loading="lazy"
            />
            <div>
              <h3 class="text-[28px]! leading-9!">
                {doc.href ? (
                  <a href={doc.href} class="transition-colors hover:text-accent">
                    {doc.title}
                  </a>
                ) : (
                  doc.title
                )}
              </h3>
              {doc.bio.map((p) => (
                <p class="mt-4 text-[16px] leading-7">{p}</p>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
