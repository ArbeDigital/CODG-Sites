---
import home from "../data/home.json";

const ctas = home.serviceCtas;
---

<section class="bg-[#f4f4f4] py-[6%]">
  <div class="mx-auto max-w-[1425px] px-6 md:px-12 xl:px-[90px]">
    <p class="font-serif-alt text-[clamp(36px,4vw,54px)] leading-[1.3] text-[#19949f]">
      Treatments
    </p>

    <ul class="mt-6 border-t border-[#d8d5d2] md:mt-8">
      {
        ctas.map((cta, i) => (
          <li class="border-b border-[#d8d5d2]">
            <a
              href={cta.href}
              class="group grid grid-cols-[1fr_auto] items-center gap-6 py-8 md:gap-12 md:py-10"
            >
              <div class="min-w-0">
                <h3 class="text-[28px]! leading-9! text-[#291f1c]! transition-colors group-hover:text-[#19949f]! md:text-[40px]! md:leading-[50px]!">
                  {cta.title}
                </h3>
                <p class="mt-2 max-w-2xl text-[16px] leading-7 text-body md:text-[17px] md:leading-8">
                  {cta.blurb}
                </p>
              </div>
              <span
                class="font-serif-alt text-[clamp(46px,7vw,95px)] leading-none text-[#291f1c] tabular-nums transition-colors group-hover:text-[#19949f]"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, "0")}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
