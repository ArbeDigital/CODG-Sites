---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import services from "../../data/services.json";
import { publicImage } from "../../lib/images";
---

<BaseLayout
  title="Dental Services | Carolina Oaks Dental Care"
  description="We provide general, restorative, cosmetic and implant dentistry, as well as emergency services, all in one convenient location."
  transparentHeader
>
  <PageHero
    title="Dental Services"
    intro="We provide general, restorative, cosmetic and implant dentistry, as well as emergency services, all in one convenient location. Our team tailors treatment to suit every patient’s concerns, preferences and personal comfort. We want you to love going to the dentist!"
    image="/images/banner-family-dentistry.jpg"
    cta={{ label: "Request An Appointment", href: "/contact-us/" }}
  />

  <section class="mx-auto max-w-[1425px] px-6 py-14 md:px-12 xl:px-[90px]">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <a
            href={`/services/${service.slug}/`}
            class="group overflow-hidden rounded-xl bg-white shadow-[0_8px_30px_rgba(47,58,53,0.08)] transition-transform hover:-translate-y-1"
          >
            <img
              src={publicImage(service.heroImage)}
              alt={`${service.title} at Carolina Oaks Dental Care of Greenville`}
              class="aspect-[16/10] w-full object-cover"
              width="640"
              height="400"
              loading="lazy"
            />
            <div class="p-6">
              <h2 class="text-[26px]! leading-8! transition-colors group-hover:text-accent">{service.title}</h2>
              <p class="mt-3 line-clamp-3 text-[15px] leading-6">{service.intro}</p>
              <span class="mt-4 inline-block text-[13px] font-bold tracking-[2px] text-accent uppercase">Learn More</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="service-prose mx-auto max-w-[900px] px-6 pb-16 md:px-12">
    <h2>Full-Service Dentistry in Greenville, SC</h2>
    <p>
      As a trusted family dentist in Greenville, SC, we can take care of all of your family’s dental needs. At our welcoming, comfortable office, our experienced team offers a broad range of professional dental services, including dental exams, pediatric dentistry, tooth extractions, oral surgery procedures and more. Our goal is to make sure you and your loved ones have healthy, happy smiles for years to come. Give Carolina Oaks Dental Care a call at 864-235-3949 to schedule an appointment with us today!
    </p>
  </section>
</BaseLayout>
